+static ggml_threadpool_t ggml_backend_cpu_threadpool(ggml_backend_cpu_context * ctx, int n_threads) {
+    if (ctx->threadpool) {
+        return ctx->threadpool;
+    }
+    if (!ctx->owned_threadpool || ctx->owned_thread_count != n_threads) {
+        auto params = ggml_threadpool_params_default(n_threads);
+        // Sleep between graphs rather than competing with the BLAS backend.
+        params.poll = 0;
+        ctx->owned_threadpool.reset(ggml_threadpool_new(&params));
+        ctx->owned_thread_count = n_threads;
+    }
+    return ctx->owned_threadpool.get();
+}
