{
  "name": "polarbear-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Polarbear desktop app - a local-first Markdown editor powered by Rust, Tauri, and TypeScript.",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "vite build",
    "caption:build": "node scripts/build-caption.mjs",
    "typecheck": "tsc --noEmit",
    "test:native-clipboard": "node scripts/test-native-clipboard.mjs",
    "test:translation-assets": "node --input-type=module -e \"import('./scripts/bundled-translation-assets.mjs').then(m => m.verifyTranslationAssets())\"",
    "test:offline-translation": "node scripts/test-bundled-translation.mjs",
    "test:ui": "playwright test",
    "lint": "eslint src",
    "memory-contract:generate": "node scripts/generate-memory-admin-contract.mjs",
    "memory-contract:check": "node scripts/generate-memory-admin-contract.mjs --check",
    "memory-m1:fixtures:check": "node scripts/validate-memory-m1-fixtures.mjs",
    "memory-m1:assets:test": "node --test scripts/memory-m1-assets.node-test.mjs",
    "memory-m1:evaluate": "node scripts/evaluate-memory-m1-results.mjs",
    "memory-m1:engine-evaluate": "node scripts/run-memory-m1-engine-evaluation.mjs",
    "test": "vitest run && node --test scripts/memory-m1-assets.node-test.mjs scripts/caption-engine-fixture.node-test.mjs scripts/macos-release-artifacts.node-test.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@browsermt/bergamot-translator": "0.4.9",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-markdown": "^6.3.4",
    "@codemirror/search": "^6.5.11",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.0",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@uiw/react-codemirror": "^4.23.13",
    "dompurify": "^3.4.12",
    "fflate": "0.8.3",
    "markdown-it": "^14.1.0",
    "mermaid": "^11.12.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.11.2",
    "@types/markdown-it": "^14.1.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "rollup": "^4.52.5",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^6.3.5",
    "vitest": "^4.1.10"
  }
}
